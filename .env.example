# ─────────────────────────────────────────────────────────────────────
# DJI Drone RAG System — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real keys.
# ─────────────────────────────────────────────────────────────────────

# OpenAI API Key (required for LLM, embeddings, Whisper)
OPENAI_API_KEY=sk-your-openai-api-key-here

# AWS (required for S3 image storage during PDF ingestion)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-north-1
S3_BUCKET_NAME=final-project-inmind

# Agent System B
AGENT_B_MODEL=gpt-4o-mini
SERPAPI_KEY=your-serpapi-key-here

# Langfuse (optional, for tracing)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:5001

# MongoDB (used by docker-compose internally, override if using Atlas)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dji_rag
